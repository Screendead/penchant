{
  "name": "Petal",
  "version": "0.1.0-mockup",
  "color": {
    "light": {
      "bg": "#F6F4EF",
      "surface": "#FFFFFF",
      "sheet": "#FFFFFF",
      "fill": "#ECE9E2",
      "text": "#1D1C1A",
      "muted": "#6B675F",
      "accent": "#1D1C1A",
      "onAccent": "#F6F4EF",
      "divider": "#1D1C1A1A",
      "spoke": "#1D1C1A73",
      "data1": "#FFB347",
      "data2": "#FF7A59",
      "data3": "#E8505B",
      "data4": "#9B5DE5",
      "data5": "#4D96FF",
      "data1Ink": "#9A5B00",
      "data2Ink": "#B4401F",
      "data3Ink": "#B42A37",
      "data4Ink": "#6E36B8",
      "data5Ink": "#1F5FC4",
      "clear": "#E3F0E4",
      "clearInk": "#276B43",
      "danger": "#FBE6E4",
      "dangerInk": "#A1262F",
      "snackAction": "#FFB347",
      "shadow": "0 4px 16px #1D1C1A0F"
    },
    "dark": {
      "bg": "#171614",
      "surface": "#22201D",
      "sheet": "#262421",
      "fill": "#2D2B27",
      "text": "#F3F1EC",
      "muted": "#A39E94",
      "accent": "#F6F4EF",
      "onAccent": "#1D1C1A",
      "divider": "#F6F4EF1A",
      "spoke": "#F6F4EF73",
      "data1": "#FFBE5C",
      "data2": "#FF8A6B",
      "data3": "#F2646E",
      "data4": "#AE7BF0",
      "data5": "#68A8FF",
      "data1Ink": "#FFBE5C",
      "data2Ink": "#FF8A6B",
      "data3Ink": "#F2646E",
      "data4Ink": "#AE7BF0",
      "data5Ink": "#68A8FF",
      "clear": "#1A2A20",
      "clearInk": "#A8DDB8",
      "danger": "#3A1E1E",
      "dangerInk": "#F5B3AC",
      "snackAction": "#9A5B00",
      "shadow": "0 4px 16px #00000059"
    },
    "rules": {
      "dataFillsAreFillOnlyInLight": "data1-5 on paper measure 1.6-3.8:1, so text and thin lines in a habit's colour use dataNInk in light. In dark the fills are text-safe and dataNInk equals dataN.",
      "assignment": "A habit's colour is its creation order across all habits, archived included: hue = order mod 5, fill = solid for 1-5, diagonal hatch for 6-10, dots for 11-15. Archiving never recolours anything.",
      "secondaryEncoding": "data2 and data3 (coral and red) are adjacent in the icon and sit 10 OKLab units apart, under the 15 floor for normal vision, and data4/data5 fall to 6.3 under deuteranopia. Every petal is therefore direct-labelled with name and amount, and wedges are separated by a 3 px gap and a spoke."
    }
  },
  "type": {
    "families": {
      "display": "Gabarito",
      "body": "Figtree",
      "numeric": "Spline Sans Mono"
    },
    "delivery": "Bundle the OFL TTFs as assets; GoogleFonts.config.allowRuntimeFetching = false.",
    "scale": {
      "dayTitle": { "family": "display", "weight": 800, "size": 34, "line": 38, "tracking": -0.01 },
      "screenTitle": { "family": "display", "weight": 800, "size": 30, "line": 34, "tracking": -0.01 },
      "wordmark": { "family": "display", "weight": 800, "size": 40, "line": 44, "tracking": -0.015 },
      "sheetTitle": { "family": "display", "weight": 700, "size": 22, "line": 26, "tracking": -0.01 },
      "cardTitle": { "family": "display", "weight": 700, "size": 18, "line": 22, "tracking": -0.005 },
      "body": { "family": "body", "weight": 400, "size": 16, "line": 22 },
      "bodyStrong": { "family": "body", "weight": 600, "size": 16, "line": 22 },
      "label": { "family": "body", "weight": 600, "size": 14, "line": 18 },
      "caption": { "family": "body", "weight": 500, "size": 12.5, "line": 16 },
      "tab": { "family": "body", "weight": 600, "size": 11, "line": 13 },
      "numXL": { "family": "numeric", "weight": 500, "size": 72, "line": 76, "tracking": -0.04 },
      "numL": { "family": "numeric", "weight": 500, "size": 22, "line": 26, "tracking": -0.02 },
      "numM": { "family": "numeric", "weight": 500, "size": 14, "line": 18 },
      "numS": { "family": "numeric", "weight": 500, "size": 11, "line": 14 }
    },
    "case": "Sentence case everywhere."
  },
  "space": { "unit": 4, "steps": [4, 8, 12, 16, 20, 24, 32, 40], "gutter": 20, "listRow": 52, "tapTarget": 44 },
  "radius": { "sheet": 28, "card": 20, "input": 14, "chip": 999, "button": 999, "selectedDay": 16 },
  "elevation": {
    "rule": "Only the Log button and sheets carry a shadow. Cards separate by surface step, never by outline.",
    "ambient": { "y": 4, "blur": 16, "color": "text", "opacity": 0.06 }
  },
  "divider": { "width": 1, "opacity": 0.1 },
  "chart": {
    "rose": { "innerFloor": 0.22, "radiusRule": "floor + (1 - floor) * sqrt(value / busiest day in the last 30)", "gap": 3, "spokeOverrun": 8, "spokeWidth": 1.5, "zeroDots": "2 px dots every 4.5 px", "pendingRim": "2 px dashed, 3 on 3" },
    "trend": { "lineWidth": 2.5, "areaOpacity": 0.12, "rawBarOpacity": 0.35, "gridOpacity": 0.08, "maxYSteps": 4 }
  },
  "motion": {
    "spring": { "mass": 1, "stiffness": 380, "damping": 26, "dampingRatio": 0.667, "overshoot": 0.06, "peakMs": 217, "within0p5PercentMs": 350, "runMs": 450, "flutter": "SpringDescription(mass: 1, stiffness: 380, damping: 26)" },
    "curves": { "opacity": "Curves.easeOutCubic", "trim": "Curves.easeInOutCubic", "breath": "Curves.easeInOutSine" },
    "durations": {
      "press": 90,
      "digitRoll": 220,
      "titleCrossfade": 220,
      "titleRise": 6,
      "dayMorphStagger": 35,
      "bloomStagger": 40,
      "lineTrim": 500,
      "averageLag": 100,
      "cleanTrim": 500,
      "cleanWash": 400,
      "breath": 1200,
      "fadeThrough": 300,
      "fadeThroughScaleFrom": 0.96,
      "syncClose": 260,
      "banner": 240,
      "undoWindow": 8000,
      "reducedMotionCrossfade": 150
    },
    "haptics": { "commit": "HapticFeedback.lightImpact", "stepper": "HapticFeedback.selectionClick" },
    "reduceMotion": "MediaQuery.disableAnimations: springs become 150 ms crossfades; no bloom, stagger or breath; haptics stay."
  }
}
