{
  "name": "Ledger",
  "version": "0.1.0",
  "description": "Design tokens for the Ledger direction. Colour appears only in data; the chrome is the icon's paper and ink, with no accent hue. Elevation is 0 everywhere.",
  "color": {
    "light": {
      "bg": "#F6F4EF",
      "surface": "#ECE9E2",
      "text": "#1D1C1A",
      "muted": "#625E57",
      "accent": "#1D1C1A",
      "onAccent": "#F6F4EF",
      "rule": "#E0DCD3",
      "ruleStrong": "#C4BEB2",
      "spoke": "rgba(29,28,26,0.45)",
      "data": [
        "#D98A12",
        "#E35F3A",
        "#D23A47",
        "#8246D4",
        "#2F7BEA"
      ],
      "dataInk": [
        "#8F5600",
        "#B03E1C",
        "#B42A37",
        "#6A31B5",
        "#1D5FC2"
      ],
      "dataEdge": [
        "rgba(29,28,26,0.20)",
        "transparent",
        "transparent",
        "transparent",
        "transparent"
      ],
      "clear": "#E1EBDD",
      "clearInk": "#276B43",
      "error": "#B42318",
      "errorSurface": "#F7E6E1",
      "offline": "#625E57"
    },
    "dark": {
      "bg": "#141311",
      "surface": "#1D1C1A",
      "text": "#F6F4EF",
      "muted": "#A29D93",
      "accent": "#F6F4EF",
      "onAccent": "#141311",
      "rule": "#2A2825",
      "ruleStrong": "#433F3A",
      "spoke": "rgba(246,244,239,0.45)",
      "data": [
        "#FFB347",
        "#FF7A59",
        "#E8505B",
        "#9B5DE5",
        "#4D96FF"
      ],
      "dataInk": [
        "#FFB347",
        "#FF7A59",
        "#E8505B",
        "#9B5DE5",
        "#4D96FF"
      ],
      "dataEdge": [
        "transparent",
        "transparent",
        "transparent",
        "transparent",
        "transparent"
      ],
      "clear": "#15221A",
      "clearInk": "#9ED8B0",
      "error": "#FF8A80",
      "errorSurface": "#2C1815",
      "offline": "#A29D93"
    },
    "habitColourRule": {
      "order": "Creation order across all habits, archived included, so a habit keeps its colour for life.",
      "1-5": "data[0..4], solid 3 px tab, solid track",
      "6-10": "the same hues, hollow (1 px outlined) tab, dashed track",
      "11-15": "the same hues mixed 28% toward ink (light) or paper (dark), solid tab"
    },
    "notes": {
      "paperAndInk": "bg is the icon's paper (#F6F4EF) and text its ink (#1D1C1A); dark mode swaps them. The app opens onto the icon's own paper.",
      "accent": "accent is the text colour. No chrome uses a data hue, so a habit's colour never doubles as a button, link, focus ring or indicator.",
      "statusColours": "error, errorSurface, clear and clearInk are the only non-data colours; clear is C5's quietly positive tint.",
      "amber": "Light-mode amber is 2.5:1 on paper, so its marks carry the dataEdge stroke; names carry identity everywhere."
    }
  },
  "type": {
    "families": {
      "display": "Archivo Narrow",
      "body": "Atkinson Hyperlegible Next",
      "numeric": "Spline Sans Mono"
    },
    "delivery": "Bundled as assets; google_fonts with GoogleFonts.config.allowRuntimeFetching = false.",
    "scale": {
      "dayTitle": {
        "family": "display",
        "weight": 600,
        "size": 28,
        "lineHeight": 32
      },
      "screenTitle": {
        "family": "display",
        "weight": 600,
        "size": 28,
        "lineHeight": 32
      },
      "appBarTitle": {
        "family": "display",
        "weight": 600,
        "size": 17,
        "lineHeight": 22
      },
      "sectionLabel": {
        "family": "display",
        "weight": 600,
        "size": 12,
        "lineHeight": 16,
        "case": "upper",
        "tracking": 0.06
      },
      "habitName": {
        "family": "body",
        "weight": 600,
        "size": 17,
        "lineHeight": 22
      },
      "body": {
        "family": "body",
        "weight": 400,
        "size": 15,
        "lineHeight": 20
      },
      "bodyStrong": {
        "family": "body",
        "weight": 600,
        "size": 15,
        "lineHeight": 20
      },
      "small": {
        "family": "body",
        "weight": 400,
        "size": 13,
        "lineHeight": 18
      },
      "count": {
        "family": "numeric",
        "weight": 500,
        "size": 32,
        "lineHeight": 36,
        "tracking": -0.02
      },
      "stat": {
        "family": "numeric",
        "weight": 500,
        "size": 20,
        "lineHeight": 24
      },
      "numeric": {
        "family": "numeric",
        "weight": 500,
        "size": 13,
        "lineHeight": 18
      },
      "tick": {
        "family": "numeric",
        "weight": 400,
        "size": 11,
        "lineHeight": 14
      },
      "scrubWeekday": {
        "family": "display",
        "weight": 600,
        "size": 11,
        "lineHeight": 12,
        "case": "upper",
        "tracking": 0.06
      },
      "scrubDate": {
        "family": "numeric",
        "weight": 400,
        "size": 12,
        "lineHeight": 14
      },
      "key": {
        "family": "body",
        "weight": 400,
        "size": 12,
        "lineHeight": 16
      }
    },
    "numericNote": "A monospace with a plain zero: a slashed or dotted zero reads as terminal output, and at 32 px a muted slashed 0 reads as the null sign. Weight 500, tabular figures. Numbers only: dates and words stay in the body face."
  },
  "space": {
    "grid": 8,
    "steps": [
      4,
      8,
      12,
      16,
      24,
      32,
      48
    ],
    "gutter": 16,
    "touchTarget": 44,
    "rowMinHeight": 80,
    "logLineHeight": 44
  },
  "radius": {
    "chip": 4,
    "row": 6,
    "card": 6,
    "button": 6,
    "sheet": 10,
    "tab": 2
  },
  "stroke": {
    "rule": 1,
    "focus": 2,
    "tab": 3,
    "trackBar": 4,
    "trackCap": 2,
    "trendRaw": 1.5,
    "trendAverage": 2.5
  },
  "elevation": 0,
  "motion": {
    "curves": {
      "move": "cubic-bezier(0.25, 1, 0.5, 1)",
      "moveFlutter": "Curves.easeOutQuart",
      "enter": "cubic-bezier(0.2, 0, 0, 1)",
      "enterFlutter": "Easing.emphasizedDecelerate",
      "trace": "cubic-bezier(0.65, 0, 0.35, 1)",
      "traceFlutter": "Curves.easeInOutCubic"
    },
    "durationsMs": {
      "digitRoll": 140,
      "syncFill": 150,
      "barExtend": 180,
      "scrubberUnderline": 180,
      "bannerGrow": 200,
      "logLineReveal": 220,
      "rowExpand": 220,
      "dayPage": 240,
      "dayPageStagger": 12,
      "tabSharedAxis": 250,
      "tabSharedAxisOffsetPx": 30,
      "push": 260,
      "trendTrace": 480,
      "trendAverageDelay": 120,
      "cleanHairlineStagger": 20,
      "syncHoldBeforeFade": 1000,
      "undo": 8000,
      "reducedCrossfade": 120,
      "pressScale": 90,
      "rowInkFlash": 420
    },
    "reduceMotion": "Rolls become instant swaps, paging and pushes become a 120 ms crossfade, traces draw at once.",
    "haptics": {
      "tap": "HapticFeedback.selectionClick",
      "commit": "HapticFeedback.lightImpact"
    },
    "press": {
      "scale": 0.94,
      "curve": "move",
      "appliesTo": "the + button and the stepper buttons"
    },
    "rowInkFlash": {
      "from": "the habit's colour at 14% over the row",
      "to": "transparent",
      "attackMs": 60,
      "note": "Marks the row a commit landed in; skipped under reduced motion."
    }
  }
}
