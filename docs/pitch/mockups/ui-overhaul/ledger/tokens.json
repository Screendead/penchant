{
  "name": "Ledger",
  "version": "0.1.0",
  "description": "Design tokens for the Ledger direction. Colour appears only in data; the chrome is monochrome. Elevation is 0 everywhere.",
  "color": {
    "light": {
      "bg": "#FFFFFF",
      "surface": "#F5F6F7",
      "text": "#111316",
      "muted": "#5E646B",
      "accent": "#1D5FC2",
      "onAccent": "#FFFFFF",
      "rule": "#E4E6E9",
      "ruleStrong": "#C5CAD0",
      "spoke": "rgba(17,19,22,0.45)",
      "data": ["#D98A12", "#E35F3A", "#D23A47", "#8246D4", "#2F7BEA"],
      "dataInk": ["#8F5600", "#B03E1C", "#B42A37", "#6A31B5", "#1D5FC2"],
      "dataEdge": ["rgba(17,19,22,0.20)", "transparent", "transparent", "transparent", "transparent"],
      "clear": "#E6F2EA",
      "clearInk": "#276B43",
      "statusAdded": "Not in the direction's palette; added for the status strips.",
      "error": "#B42318",
      "errorSurface": "#FCEEEC",
      "offline": "#5E646B"
    },
    "dark": {
      "bg": "#0E0F11",
      "surface": "#17191C",
      "text": "#ECEEF0",
      "muted": "#9097A0",
      "accent": "#4D96FF",
      "onAccent": "#0E0F11",
      "rule": "#262A2F",
      "ruleStrong": "#3A4047",
      "spoke": "rgba(236,238,240,0.45)",
      "data": ["#FFB347", "#FF7A59", "#E8505B", "#9B5DE5", "#4D96FF"],
      "dataInk": ["#FFB347", "#FF7A59", "#E8505B", "#9B5DE5", "#4D96FF"],
      "dataEdge": ["transparent", "transparent", "transparent", "transparent", "transparent"],
      "clear": "#13241A",
      "clearInk": "#9ED8B0",
      "error": "#FF8A80",
      "errorSurface": "#2A1616",
      "offline": "#9097A0"
    },
    "habitColourRule": {
      "order": "Creation order across all habits, archived included, so a habit keeps its colour for life.",
      "1-5": "data[0..4], solid 3 px tab, solid track",
      "6-10": "the same hues, hollow (1 px outlined) tab, dashed track",
      "11-15": "the same hues mixed 28% toward black (light) or text (dark), solid tab"
    }
  },
  "type": {
    "families": {
      "display": "Archivo Narrow",
      "body": "Atkinson Hyperlegible Next",
      "numeric": "Martian Mono"
    },
    "delivery": "Bundled as assets; google_fonts with GoogleFonts.config.allowRuntimeFetching = false.",
    "scale": {
      "dayTitle":     { "family": "display", "weight": 600, "size": 28, "lineHeight": 32 },
      "screenTitle":  { "family": "display", "weight": 600, "size": 28, "lineHeight": 32 },
      "appBarTitle":  { "family": "display", "weight": 600, "size": 17, "lineHeight": 22 },
      "sectionLabel": { "family": "display", "weight": 600, "size": 12, "lineHeight": 16, "case": "upper", "tracking": 0.06 },
      "habitName":    { "family": "body", "weight": 600, "size": 17, "lineHeight": 22 },
      "body":         { "family": "body", "weight": 400, "size": 15, "lineHeight": 20 },
      "bodyStrong":   { "family": "body", "weight": 600, "size": 15, "lineHeight": 20 },
      "small":        { "family": "body", "weight": 400, "size": 13, "lineHeight": 18 },
      "count":        { "family": "numeric", "weight": 500, "size": 32, "lineHeight": 36, "tracking": -0.02 },
      "stat":         { "family": "numeric", "weight": 500, "size": 20, "lineHeight": 24 },
      "numeric":      { "family": "numeric", "weight": 500, "size": 13, "lineHeight": 18 },
      "tick":         { "family": "numeric", "weight": 400, "size": 11, "lineHeight": 14 }
    }
  },
  "space": {
    "grid": 8,
    "steps": [4, 8, 12, 16, 24, 32, 48],
    "gutter": 16,
    "touchTarget": 44,
    "rowMinHeight": 80,
    "logLineHeight": 44
  },
  "radius": { "chip": 4, "row": 6, "card": 6, "button": 6, "sheet": 10, "tab": 2 },
  "stroke": { "rule": 1, "focus": 2, "tab": 3, "trackBar": 4, "trackCap": 2, "trendRaw": 1.5, "trendAverage": 2.5 },
  "elevation": 0,
  "motion": {
    "curves": {
      "move": "cubic-bezier(0.25, 1, 0.5, 1)",
      "moveFlutter": "Curves.easeOutQuart",
      "enter": "cubic-bezier(0.2, 0, 0, 1)",
      "enterFlutter": "Easing.emphasizedDecelerate",
      "trace": "cubic-bezier(0.65, 0, 0.35, 1)",
      "traceFlutter": "Curves.easeInOutCubic"
    },
    "durationsMs": {
      "digitRoll": 140,
      "syncFill": 150,
      "barExtend": 180,
      "scrubberUnderline": 180,
      "bannerGrow": 200,
      "logLineReveal": 220,
      "rowExpand": 220,
      "dayPage": 240,
      "dayPageStagger": 12,
      "tabSharedAxis": 250,
      "tabSharedAxisOffsetPx": 30,
      "push": 260,
      "trendTrace": 480,
      "trendAverageDelay": 120,
      "cleanHairlineStagger": 20,
      "syncHoldBeforeFade": 1000,
      "undo": 8000,
      "reducedCrossfade": 120
    },
    "reduceMotion": "Rolls become instant swaps, paging and pushes become a 120 ms crossfade, traces draw at once.",
    "haptics": { "tap": "HapticFeedback.selectionClick", "commit": "HapticFeedback.lightImpact" }
  }
}
