{
  "name": "Day Dial",
  "version": "0.1.0-mockup",
  "color": {
    "light": {
      "bg": "#EDF1F7",
      "surface": "#FFFFFF",
      "surface2": "#F3F6FA",
      "text": "#141B2D",
      "muted": "#5B6478",
      "line": "#141B2D1A",
      "accent": "#1D5FC2",
      "onAccent": "#FFFFFF",
      "danger": "#B42A37",
      "dangerContainer": "#FBE7E9",
      "data1": "#F2A23A",
      "data2": "#F5714F",
      "data3": "#DE4654",
      "data4": "#8F55D9",
      "data5": "#3F86F0",
      "data1Ink": "#8F5600",
      "data2Ink": "#B03E1C",
      "data3Ink": "#B42A37",
      "data4Ink": "#6A31B5",
      "data5Ink": "#1D5FC2",
      "spoke": "#141B2D73",
      "clear": "#E3F0E8",
      "clearInk": "#276B43",
      "scrim": "#13203D2E"
    },
    "dark": {
      "bg": "#0C1222",
      "surface": "#151D31",
      "surface2": "#1C2540",
      "text": "#E9EDF5",
      "muted": "#8E98AE",
      "line": "#E9EDF51F",
      "accent": "#FFB347",
      "onAccent": "#1A1405",
      "danger": "#FF8A8F",
      "dangerContainer": "#3A1A22",
      "data1": "#FFB347",
      "data2": "#FF7A59",
      "data3": "#E8505B",
      "data4": "#9B5DE5",
      "data5": "#4D96FF",
      "data1Ink": "#FFB347",
      "data2Ink": "#FF7A59",
      "data3Ink": "#F0737C",
      "data4Ink": "#B48AF0",
      "data5Ink": "#4D96FF",
      "spoke": "#E9EDF573",
      "clear": "#12241E",
      "clearInk": "#9ED8B0",
      "scrim": "#03060EA6"
    },
    "habitColourRule": "Colour follows creation order, archived habits included. Habits 1-5 are filled beads in data1-data5. Habits 6-10 are hollow rings in the same five hues, 11-15 dotted rings. Text about a habit uses its dataNInk.",
    "beadTreatment": {
      "light": "Fill only, plus an inner 1 px rim in dataNInk at 55% (beads are 1.9-4.7:1 against bg and surface).",
      "dark": "Fill plus an 8 px glow (blur 6 px) at 35% of the bead's own colour. No rim."
    }
  },
  "type": {
    "families": {
      "display": "Red Hat Display",
      "text": "Red Hat Text",
      "mono": "Red Hat Mono"
    },
    "delivery": "google_fonts 8.2.1 with GoogleFonts.config.allowRuntimeFetching = false; the .ttf files bundled under assets/google_fonts/.",
    "scale": {
      "displayXL": { "family": "display", "weight": 900, "size": 34, "line": 40, "tracking": -0.5, "use": "Screen titles (Habits, a habit's name), the auth wordmark at 40" },
      "displayL": { "family": "display", "weight": 900, "size": 26, "line": 32, "tracking": -0.3, "use": "Sheet titles (Trends), the app-bar wordmark at 21" },
      "displayM": { "family": "display", "weight": 700, "size": 17, "line": 22, "use": "The day title in the date pill" },
      "dialNumeral": { "family": "display", "weight": 700, "size": 12, "line": 12, "tracking": 0.6, "use": "00, 06, 12, 18 around the dial" },
      "bodyL": { "family": "text", "weight": 500, "size": 16, "line": 22, "use": "Row names, tally names" },
      "body": { "family": "text", "weight": 400, "size": 15, "line": 21, "use": "Copy" },
      "bodyS": { "family": "text", "weight": 400, "size": 13, "line": 18, "use": "Secondary lines, captions" },
      "label": { "family": "text", "weight": 600, "size": 15, "line": 20, "use": "Buttons, segments, chips at 13" },
      "monoXL": { "family": "mono", "weight": 500, "size": 40, "line": 44, "use": "Stepper amount" },
      "monoL": { "family": "mono", "weight": 500, "size": 22, "line": 26, "use": "Hub clock, stat tiles" },
      "monoM": { "family": "mono", "weight": 500, "size": 15, "line": 20, "use": "Tally totals, entry times" },
      "monoS": { "family": "mono", "weight": 500, "size": 10, "line": 12, "use": "Chart ticks and dates" }
    },
    "numerals": "Mono cuts carry tabular figures; never set a changing number in a proportional face."
  },
  "space": { "xxs": 4, "xs": 8, "s": 12, "m": 16, "l": 20, "xl": 24, "xxl": 32, "xxxl": 40, "gutter": 20 },
  "radius": { "card": 24, "sheet": 32, "tile": 18, "pill": 999, "input": 999, "iconTile": 22 },
  "size": {
    "logButton": 64,
    "circleButton": 40,
    "pillHeight": 52,
    "chipHeight": 34,
    "tallyRow": 36,
    "dial": { "diameter": 320, "rim": 124, "beadTrack": 100, "stackTracks": [100, 116, 84, 68], "hub": 44, "spokeInner": 54, "spokeOuter": 140, "beadRadius": "7.5 * sqrt(quantity / typical quantity), clamped to 5..14" }
  },
  "elevation": {
    "light": { "card": "1 px line rim + 0 2 8 #141B2D14", "sheet": "0 -6 24 #141B2D1F" },
    "dark": { "card": "1 px line rim, no shadow", "sheet": "1 px line rim, no shadow", "bead": "glow, see color.beadTreatment" }
  },
  "motion": {
    "curves": {
      "travel": "Curves.easeInOutCubic",
      "exit": "Curves.easeInCubic",
      "enter": "Curves.easeOutCubic",
      "landing": "SpringDescription(mass: 1, stiffness: 220, damping: 22)",
      "sheetSnap": "SpringDescription(mass: 1, stiffness: 220, damping: 22), carrying the release velocity"
    },
    "duration": {
      "beadTravel": 520,
      "landingRipple": 300,
      "tallyRoll": 300,
      "dayContract": 200,
      "daySweep": 600,
      "cleanDayGlow": 600,
      "fadeThrough": 320,
      "containerTransform": 450,
      "chartMorph": 450,
      "pendingFill": 240,
      "pendingRotation": 2000,
      "bannerDrop": 260,
      "fanStagger": 30,
      "fanClose": 160,
      "holdForAmount": 400,
      "undoWindow": 8000,
      "reducedFade": 150
    },
    "reducedMotion": "MediaQuery.disableAnimations: no travel, no sweep, no spring; beads and content fade in together over 150 ms; the now-hand moves once a minute without animating.",
    "haptics": { "landing": "HapticFeedback.lightImpact", "fanOpen": "HapticFeedback.selectionClick", "holdForAmount": "HapticFeedback.mediumImpact", "timeScrubSnap": "HapticFeedback.selectionClick per 5 min step" }
  }
}
