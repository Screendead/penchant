{
  "name": "Day Dial",
  "version": "0.2.0-mockup",
  "color": {
    "light": {
      "bg": "#F6F4EF",
      "surface": "#FFFFFF",
      "surface2": "#EFECE5",
      "text": "#1D1C1A",
      "muted": "#635E56",
      "line": "#1D1C1A1A",
      "outline": "#1D1C1A8C",
      "accent": "#1D1C1A",
      "onAccent": "#F6F4EF",
      "danger": "#B42A37",
      "dangerContainer": "#F8E4E2",
      "data1": "#FFB347",
      "data2": "#FF7A59",
      "data3": "#E8505B",
      "data4": "#9B5DE5",
      "data5": "#4D96FF",
      "data1Ink": "#8F5600",
      "data2Ink": "#B03E1C",
      "data3Ink": "#B42A37",
      "data4Ink": "#6A31B5",
      "data5Ink": "#1D5FC2",
      "spoke": "#1D1C1A80",
      "clear": "#E3EFE4",
      "clearInk": "#276B43",
      "scrim": "#1D1C1A33",
      "wedgeInk": "#120F0C"
    },
    "dark": {
      "bg": "#151412",
      "surface": "#1F1D1B",
      "surface2": "#2A2825",
      "text": "#F3F0EA",
      "muted": "#ACA79D",
      "line": "#F3F0EA1F",
      "outline": "#F3F0EA66",
      "accent": "#F3F0EA",
      "onAccent": "#1D1C1A",
      "danger": "#FF8A8F",
      "dangerContainer": "#3A1D1E",
      "data1": "#FFB347",
      "data2": "#FF7A59",
      "data3": "#E95963",
      "data4": "#A973E9",
      "data5": "#4D96FF",
      "data1Ink": "#FFB347",
      "data2Ink": "#FF7A59",
      "data3Ink": "#F0737C",
      "data4Ink": "#B48AF0",
      "data5Ink": "#4D96FF",
      "spoke": "#F3F0EA80",
      "clear": "#15241B",
      "clearInk": "#9ED8B0",
      "scrim": "#0A0908A6",
      "wedgeInk": "#120F0C"
    },
    "habitColourRule": "Colour follows creation order, archived habits included. Habits 1-5 are filled beads in data1-data5. Habits 6-10 are hollow rings, 11-15 dotted rings, drawn in the same five hues' inks (dataNInk), as are text about a habit and every thin habit mark.",
    "beadTreatment": {
      "light": "The icon's colour as fill, plus an inner 1.25 px rim in dataNInk at 90%, which holds 3:1 against every ground the mark sits on (WCAG 1.4.11).",
      "dark": "The habit's colour as fill plus an 8 px glow (blur 6 px) at 25% of the bead's own colour, against which the fill holds 3:1. No rim."
    },
    "principle": "Chrome is ink on paper (paper on ink in dark), taken from the icon's ground and spokes. The icon's five colours mean habits and nothing else: no accent, link or selection borrows one, so amber never reads as both 'Coffee' and 'press here'.",
    "contrast": "Every pair meets WCAG 2.2 AA in both themes: docs/design-system/day-dial/project/contrast-pairs.json, checked by tools/contrast-check.py and test/contrast_test.dart.",
    "links": "text colour, 600, underlined; never a habit colour"
  },
  "type": {
    "families": {
      "display": "Red Hat Display",
      "text": "Red Hat Text",
      "mono": "Red Hat Mono"
    },
    "delivery": "google_fonts 8.2.1 with GoogleFonts.config.allowRuntimeFetching = false; the .ttf files bundled under assets/google_fonts/.",
    "scale": {
      "displayXL": {
        "family": "display",
        "weight": 900,
        "size": 34,
        "line": 40,
        "tracking": -0.5,
        "use": "Screen titles (Habits, a habit's name), the auth wordmark at 40"
      },
      "displayL": {
        "family": "display",
        "weight": 900,
        "size": 26,
        "line": 32,
        "tracking": -0.3,
        "use": "Sheet titles (Trends), the app-bar wordmark at 21"
      },
      "displayM": {
        "family": "display",
        "weight": 700,
        "size": 17,
        "line": 22,
        "use": "The day title in the date pill"
      },
      "dialNumeral": {
        "family": "display",
        "weight": 700,
        "size": 12,
        "line": 12,
        "tracking": 0.6,
        "use": "00, 06, 12, 18 around the dial"
      },
      "bodyL": {
        "family": "text",
        "weight": 500,
        "size": 16,
        "line": 22,
        "use": "Row names, tally names"
      },
      "body": {
        "family": "text",
        "weight": 400,
        "size": 15,
        "line": 21,
        "use": "Copy"
      },
      "bodyS": {
        "family": "text",
        "weight": 400,
        "size": 13,
        "line": 18,
        "use": "Secondary lines, captions"
      },
      "label": {
        "family": "text",
        "weight": 600,
        "size": 15,
        "line": 20,
        "use": "Buttons, segments, chips at 13"
      },
      "monoXL": {
        "family": "mono",
        "weight": 500,
        "size": 40,
        "line": 44,
        "use": "Stepper amount"
      },
      "monoL": {
        "family": "mono",
        "weight": 500,
        "size": 22,
        "line": 26,
        "use": "Hub clock, stat tiles"
      },
      "monoM": {
        "family": "mono",
        "weight": 500,
        "size": 15,
        "line": 20,
        "use": "Tally totals, entry times (the number only; units stay in Text)"
      },
      "monoS": {
        "family": "mono",
        "weight": 500,
        "size": 10,
        "line": 12,
        "use": "Chart ticks and dates"
      },
      "dialTime": {
        "family": "mono",
        "weight": 500,
        "size": 11,
        "line": 11,
        "use": "Time beside each bead on a day of 4 entries or fewer, haloed in surface"
      }
    },
    "numerals": "Mono cuts carry tabular figures and set numbers only: '2 drinks' is a Mono 2 and a Text 'drinks'. Never set a changing number in a proportional face."
  },
  "space": {
    "xxs": 4,
    "xs": 8,
    "s": 12,
    "m": 16,
    "l": 20,
    "xl": 24,
    "xxl": 32,
    "xxxl": 40,
    "gutter": 20
  },
  "radius": {
    "card": 24,
    "sheet": 32,
    "tile": 18,
    "pill": 999,
    "input": 999,
    "iconTile": 22
  },
  "size": {
    "logButton": 64,
    "circleButton": 40,
    "pillHeight": 52,
    "chipHeight": 34,
    "tallyRow": 38,
    "dial": {
      "diameter": 320,
      "rim": 124,
      "beadTrack": 100,
      "stackTracks": [
        100,
        116,
        84,
        68
      ],
      "hub": 44,
      "spokeInner": 54,
      "spokeOuter": 140,
      "beadRadius": "7.5 * sqrt(quantity / typical quantity), clamped to 5..14",
      "hand": "ink, 2 px, from hub to 140, ringed tip (r 3.6) on the rim at 124"
    },
    "tallyPlus": "32 pt visual, 44 pt hit area"
  },
  "elevation": {
    "light": {
      "card": "1 px line rim + 0 2 8 #141B2D14",
      "sheet": "0 -6 24 #141B2D1F"
    },
    "dark": {
      "card": "1 px line rim, no shadow",
      "sheet": "1 px line rim, no shadow",
      "bead": "glow, see color.beadTreatment"
    }
  },
  "motion": {
    "curves": {
      "travel": "Curves.easeInOutCubic",
      "exit": "Curves.easeInCubic",
      "enter": "Curves.easeOutCubic",
      "landing": "SpringDescription(mass: 1, stiffness: 220, damping: 22)",
      "sheetSnap": "SpringDescription(mass: 1, stiffness: 220, damping: 22), carrying the release velocity"
    },
    "duration": {
      "beadTravel": 520,
      "landingRipple": 300,
      "tallyRoll": 300,
      "dayContract": 200,
      "daySweep": 600,
      "cleanDayGlow": 600,
      "fadeThrough": 320,
      "containerTransform": 450,
      "chartMorph": 450,
      "pendingFill": 240,
      "pendingRotation": 2000,
      "bannerDrop": 260,
      "fanStagger": 30,
      "fanClose": 160,
      "holdForAmount": 400,
      "undoWindow": 8000,
      "reducedFade": 150
    },
    "reducedMotion": "MediaQuery.disableAnimations: no travel, no sweep, no spring; beads and content fade in together over 150 ms; the now-hand moves once a minute without animating.",
    "haptics": {
      "landing": "HapticFeedback.lightImpact",
      "fanOpen": "HapticFeedback.selectionClick",
      "holdForAmount": "HapticFeedback.mediumImpact",
      "timeScrubSnap": "HapticFeedback.selectionClick per 5 min step"
    }
  }
}
