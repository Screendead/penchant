rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerID == request.auth.uid;
    }

    function createsOwn() {
      return signedIn() && request.resource.data.ownerID == request.auth.uid;
    }

    // Updates validate only the fields they change, so documents written before
    // a field existed (vices without `archived`) or holding a unit outside the
    // current enum stay editable.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A missing vice makes get() null and the field access an error, which
    // denies. Each call is a billed read, even when the request is denied.
    function ownsVice(viceID) {
      return get(/databases/$(database)/documents/vices/$(viceID)).data.ownerID == request.auth.uid;
    }

    // size() counts UTF-16 code units in the emulator, the same as Dart's
    // String.length, which lib/data/limits.dart checks against.
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 60;
    }

    // Must match the names of the Unit enum in lib/data/unit.dart.
    function validUnit(unit) {
      return unit in ['item', 'time', 'puff', 'drink', 'minute', 'hour'];
    }

    // An envelope from lib/crypto/sealer.dart: 29 bytes of version, nonce
    // and tag around a plaintext padded to at most 4096 bytes. Its contents
    // can't be checked here, so the Dart validators in lib/data/limits.dart
    // are the only guard on a sealed name or unit.
    function validSealed(sealed) {
      return sealed is bytes && sealed.size() > 29 && sealed.size() <= 4125;
    }

    // A document holds its content either sealed or in plaintext, never both.
    function sealedAlone(data, contentFields) {
      return !('sealed' in data) || !data.keys().hasAny(contentFields);
    }

    // A changed content field is either valid or removed in favour of the
    // envelope. Removing a field makes it an affected key.
    function changedContent(field, valid) {
      return !(field in changedKeys())
        || (field in request.resource.data ? valid : 'sealed' in request.resource.data);
    }

    match /vices/{viceID} {
      allow read, delete: if ownsExisting();

      allow create: if createsOwn()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.archived is bool
        && ((request.resource.data.keys().hasAll(['name', 'unit', 'ownerID', 'createdAt', 'archived'])
            && request.resource.data.keys().hasOnly(['name', 'unit', 'ownerID', 'createdAt', 'archived'])
            && validName(request.resource.data.name)
            && validUnit(request.resource.data.unit))
          || (request.resource.data.keys().hasAll(['sealed', 'ownerID', 'createdAt', 'archived'])
            && request.resource.data.keys().hasOnly(['sealed', 'ownerID', 'createdAt', 'archived'])
            && validSealed(request.resource.data.sealed)));

      allow update: if ownsExisting()
        && changedKeys().hasOnly(['name', 'unit', 'archived', 'sealed'])
        && changedContent('name', validName(request.resource.data.get('name', null)))
        && changedContent('unit', validUnit(request.resource.data.get('unit', null)))
        && (!('sealed' in changedKeys()) || validSealed(request.resource.data.get('sealed', null)))
        && sealedAlone(request.resource.data, ['name', 'unit'])
        && (!('archived' in changedKeys()) || request.resource.data.archived is bool);
    }

    match /activities/{activityID} {
      allow read, delete: if ownsExisting();

      // The quantity stays plaintext beside any envelope (Jack, 2026-11-06),
      // so a server-side job can sum it. No activity field is sealed yet: the
      // triggers field joins sealedAlone's list when it lands.
      // ownsVice() last, so a request the other checks deny costs no read.
      allow create: if createsOwn()
        && request.resource.data.keys().hasAll(['viceID', 'quantity', 'ownerID', 'createdAt'])
        && request.resource.data.keys().hasOnly(['viceID', 'quantity', 'ownerID', 'createdAt', 'sealed'])
        && request.resource.data.viceID is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.createdAt is timestamp
        && (!('sealed' in request.resource.data) || validSealed(request.resource.data.sealed))
        && sealedAlone(request.resource.data, [])
        && ownsVice(request.resource.data.viceID);

      allow update: if ownsExisting()
        && changedKeys().hasOnly(['quantity', 'createdAt', 'sealed'])
        && (!('quantity' in changedKeys())
          || (request.resource.data.quantity is int && request.resource.data.quantity > 0))
        && (!('sealed' in changedKeys()) || validSealed(request.resource.data.get('sealed', null)))
        && sealedAlone(request.resource.data, [])
        && (!('createdAt' in changedKeys()) || request.resource.data.createdAt is timestamp);
    }
  }
}
