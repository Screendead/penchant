rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerID == request.auth.uid;
    }

    function createsOwn() {
      return signedIn() && request.resource.data.ownerID == request.auth.uid;
    }

    // Updates validate only the fields they change, so documents written before
    // a field existed (vices without `archived`) or holding a unit outside the
    // current enum stay editable.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A missing vice makes get() null and the field access an error, which
    // denies. Each call is a billed read, even when the request is denied.
    function ownsVice(viceID) {
      return get(/databases/$(database)/documents/vices/$(viceID)).data.ownerID == request.auth.uid;
    }

    // size() counts UTF-16 code units in the emulator, the same as Dart's
    // String.length, which lib/data/limits.dart checks against.
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 60;
    }

    // Must match the names of the Unit enum in lib/data/unit.dart.
    function validUnit(unit) {
      return unit in ['item', 'time', 'puff', 'drink', 'minute', 'hour'];
    }

    // An envelope from lib/crypto/sealer.dart: 29 bytes of version, nonce
    // and tag around a plaintext padded to at most 4096 bytes. Its contents
    // can't be checked here, so the Dart validators in lib/data/limits.dart
    // are the only guard on a sealed name or unit.
    function validSealed(sealed) {
      return sealed is bytes && sealed.size() > 29 && sealed.size() <= 4125;
    }

    // A document holds its content either sealed or in plaintext, never both.
    function sealedAlone(data, contentFields) {
      return !('sealed' in data) || !data.keys().hasAny(contentFields);
    }

    // A changed content field is either valid or removed in favour of the
    // envelope. Removing a field makes it an affected key.
    function changedContent(field, valid) {
      return !(field in changedKeys())
        || (field in request.resource.data ? valid : 'sealed' in request.resource.data);
    }

    // Must match the names of the ViceCategory enum in lib/data/category.dart.
    function validCategory(category) {
      return category in ['alcohol', 'caffeine', 'nicotine', 'cannabis', 'food', 'gambling', 'other'];
    }

    // Rules cannot loop, so each of the 10 allowed entries is checked by index;
    // an index past the end is skipped. Must match lib/data/limits.dart.
    function validTrigger(triggers, i) {
      return triggers.size() <= i
        || (triggers[i] is string && triggers[i].size() > 0 && triggers[i].size() <= 60);
    }

    function validTriggers(triggers) {
      return triggers is list
        && triggers.size() <= 10
        && validTrigger(triggers, 0)
        && validTrigger(triggers, 1)
        && validTrigger(triggers, 2)
        && validTrigger(triggers, 3)
        && validTrigger(triggers, 4)
        && validTrigger(triggers, 5)
        && validTrigger(triggers, 6)
        && validTrigger(triggers, 7)
        && validTrigger(triggers, 8)
        && validTrigger(triggers, 9);
    }

    match /vices/{viceID} {
      allow read, delete: if ownsExisting();

      // Sealed only (Jack, 2026-11-09, `plaintext-creates` C): a new vice's
      // name, unit and category exist only inside the envelope. Plaintext
      // vices written earlier stay readable and editable below.
      allow create: if createsOwn()
        && request.resource.data.keys().hasAll(['sealed', 'ownerID', 'createdAt', 'archived'])
        && request.resource.data.keys().hasOnly(['sealed', 'ownerID', 'createdAt', 'archived'])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.archived is bool
        && validSealed(request.resource.data.sealed);

      allow update: if ownsExisting()
        && changedKeys().hasOnly(['name', 'unit', 'archived', 'category', 'sealed'])
        && changedContent('name', validName(request.resource.data.get('name', null)))
        && changedContent('unit', validUnit(request.resource.data.get('unit', null)))
        && changedContent('category', validCategory(request.resource.data.get('category', null)))
        && (!('sealed' in changedKeys()) || validSealed(request.resource.data.get('sealed', null)))
        && sealedAlone(request.resource.data, ['name', 'unit', 'category'])
        && (!('archived' in changedKeys()) || request.resource.data.archived is bool);
    }

    // `amount` is optional: documents without it, and clients that never
    // write it, stay valid. A missing amount reads as the default 1.
    function validAmount(data) {
      return data.get('amount', 1) is number && data.get('amount', 1) > 0;
    }

    match /activities/{activityID} {
      allow read, delete: if ownsExisting();

      // The quantity and amount stay plaintext beside the envelope (Jack,
      // 2026-11-06), so a server-side job can sum them; the triggers are
      // sealed, and a create without the envelope is refused (Jack,
      // 2026-11-09, `plaintext-creates` C). ownsVice() last, so a request the
      // other checks deny costs no read.
      allow create: if createsOwn()
        && request.resource.data.keys().hasAll(['viceID', 'quantity', 'ownerID', 'createdAt', 'sealed'])
        && request.resource.data.keys().hasOnly(['viceID', 'quantity', 'ownerID', 'createdAt', 'amount', 'sealed'])
        && request.resource.data.viceID is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.createdAt is timestamp
        && validAmount(request.resource.data)
        && validSealed(request.resource.data.sealed)
        && ownsVice(request.resource.data.viceID);

      allow update: if ownsExisting()
        && changedKeys().hasOnly(['quantity', 'createdAt', 'amount', 'triggers', 'sealed'])
        && (!('quantity' in changedKeys())
          || (request.resource.data.quantity is int && request.resource.data.quantity > 0))
        && (!('createdAt' in changedKeys()) || request.resource.data.createdAt is timestamp)
        && (!('amount' in changedKeys()) || validAmount(request.resource.data))
        && (!('triggers' in changedKeys())
          || !('triggers' in request.resource.data)
          || validTriggers(request.resource.data.triggers))
        && (!('sealed' in changedKeys()) || validSealed(request.resource.data.get('sealed', null)))
        && sealedAlone(request.resource.data, ['triggers']);
    }

    // The journal key's id and its copy wrapped under the recovery key; never
    // the key itself. The wrap is Sealer's envelope around 32 bytes: 61.
    match /keys/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['keyID', 'wrapped', 'createdAt', 'saved', 'cardDismissed'])
        && request.resource.data.keys().hasOnly(['keyID', 'wrapped', 'createdAt', 'saved', 'cardDismissed'])
        && request.resource.data.keyID is string
        && request.resource.data.keyID.size() == 24
        && request.resource.data.wrapped is bytes
        && request.resource.data.wrapped.size() == 61
        && request.resource.data.createdAt is timestamp
        && request.resource.data.saved is bool
        && request.resource.data.cardDismissed is bool;
    }

    // Written only by the monthly summaries function, whose Admin SDK bypasses
    // these rules; nobody edits a typical by hand.
    match /summaries/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // The orphaned guest data job's state: uids whose accounts are gone. Only
    // its Admin SDK, which bypasses these rules, reads or writes it.
    match /cleanup/{doc} {
      allow read, write: if false;
    }
  }
}
