rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerID == request.auth.uid;
    }

    function createsOwn() {
      return signedIn() && request.resource.data.ownerID == request.auth.uid;
    }

    // Updates validate only the fields they change, so documents written before
    // a field existed (vices without `archived`) or holding a unit outside the
    // current enum stay editable.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A missing vice makes get() null and the field access an error, which
    // denies. Each call is a billed read, even when the request is denied.
    function ownsVice(viceID) {
      return get(/databases/$(database)/documents/vices/$(viceID)).data.ownerID == request.auth.uid;
    }

    // size() counts UTF-16 code units in the emulator, the same as Dart's
    // String.length, which lib/data/limits.dart checks against.
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 60;
    }

    // Must match the names of the Unit enum in lib/data/unit.dart.
    function validUnit(unit) {
      return unit in ['item', 'time', 'puff', 'drink', 'minute', 'hour'];
    }

    // Must match the names of the ViceCategory enum in lib/data/category.dart.
    function validCategory(category) {
      return category in ['alcohol', 'caffeine', 'nicotine', 'cannabis', 'food', 'gambling', 'other'];
    }

    // Rules cannot loop, so each of the 10 allowed entries is checked by index;
    // an index past the end is skipped. Must match lib/data/limits.dart.
    function validTrigger(triggers, i) {
      return triggers.size() <= i
        || (triggers[i] is string && triggers[i].size() > 0 && triggers[i].size() <= 60);
    }

    function validTriggers(triggers) {
      return triggers is list
        && triggers.size() <= 10
        && validTrigger(triggers, 0)
        && validTrigger(triggers, 1)
        && validTrigger(triggers, 2)
        && validTrigger(triggers, 3)
        && validTrigger(triggers, 4)
        && validTrigger(triggers, 5)
        && validTrigger(triggers, 6)
        && validTrigger(triggers, 7)
        && validTrigger(triggers, 8)
        && validTrigger(triggers, 9);
    }

    match /vices/{viceID} {
      allow read, delete: if ownsExisting();

      allow create: if createsOwn()
        && request.resource.data.keys().hasAll(['name', 'unit', 'ownerID', 'createdAt', 'archived'])
        && request.resource.data.keys().hasOnly(['name', 'unit', 'ownerID', 'createdAt', 'archived', 'category'])
        && validName(request.resource.data.name)
        && validUnit(request.resource.data.unit)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.archived is bool
        // Optional: app versions before the field still create without it.
        && validCategory(request.resource.data.get('category', 'other'));

      allow update: if ownsExisting()
        && changedKeys().hasOnly(['name', 'unit', 'archived', 'category'])
        && (!('name' in changedKeys()) || validName(request.resource.data.name))
        && (!('unit' in changedKeys()) || validUnit(request.resource.data.unit))
        && (!('archived' in changedKeys()) || request.resource.data.archived is bool)
        && (!('category' in changedKeys()) || validCategory(request.resource.data.category));
    }

    // `amount` is optional: documents without it, and clients that never
    // write it, stay valid. A missing amount reads as the default 1.
    function validAmount(data) {
      return data.get('amount', 1) is number && data.get('amount', 1) > 0;
    }

    match /activities/{activityID} {
      allow read, delete: if ownsExisting();

      allow create: if createsOwn()
        && request.resource.data.keys().hasAll(['viceID', 'quantity', 'ownerID', 'createdAt'])
        && request.resource.data.keys().hasOnly(['viceID', 'quantity', 'ownerID', 'createdAt', 'amount', 'triggers'])
        && request.resource.data.viceID is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.createdAt is timestamp
        && validAmount(request.resource.data)
        && (!('triggers' in request.resource.data) || validTriggers(request.resource.data.triggers))
        && ownsVice(request.resource.data.viceID);

      allow update: if ownsExisting()
        && changedKeys().hasOnly(['quantity', 'createdAt', 'amount', 'triggers'])
        && (!('quantity' in changedKeys())
          || (request.resource.data.quantity is int && request.resource.data.quantity > 0))
        && (!('createdAt' in changedKeys()) || request.resource.data.createdAt is timestamp)
        && (!('amount' in changedKeys()) || validAmount(request.resource.data))
        && (!('triggers' in changedKeys())
          || !('triggers' in request.resource.data)
          || validTriggers(request.resource.data.triggers));
    }
  }
}
