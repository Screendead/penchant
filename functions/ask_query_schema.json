{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": { "type": "string", "enum": ["answer", "needs_insights", "cannot_answer"] },
    "reason": {
      "type": "string",
      "enum": ["none", "not_about_journal", "unknown_habit", "not_supported", "unclear"]
    },
    "cards": { "type": "array", "items": { "$ref": "#/$defs/card" } }
  },
  "required": ["kind", "reason", "cards"],
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "explain": { "type": "string" },
        "sql": { "type": "string" },
        "chart": { "$ref": "#/$defs/chart" }
      },
      "required": ["title", "explain", "sql", "chart"]
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["number", "bar", "line", "table"] },
        "x": { "type": "string" },
        "y": { "type": "array", "items": { "type": "string" } },
        "series": { "type": "string" },
        "x_kind": {
          "type": "string",
          "enum": ["day", "week", "month", "year", "hour", "weekday", "category", "none"]
        }
      },
      "required": ["type", "x", "y", "series", "x_kind"]
    }
  }
}
